# Copy to .env.local for local dev. On Render, add each in Dashboard → service → Environment.
# NEXT_PUBLIC_* values are baked in at build time: redeploy after changing them.

# ── 1. Database (required for durable records) ─────────────────────────────
# https://console.neon.tech → New project → Connect → turn Connection pooling OFF → copy the direct string
# (Prisma migrations need a direct connection). Must include ?sslmode=require
DATABASE_URL=

# ── 2. Site ────────────────────────────────────────────────────────────────
# Your public URL, e.g. https://patch-agent.onrender.com (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# An inbox you actually read; shown on /security and llms.txt
NEXT_PUBLIC_SECURITY_CONTACT=
# Public source repo URL
NEXT_PUBLIC_GITHUB_REPO=https://github.com/VineetKamath/phpagent
# Keep false in production. true = simulated DEMO events for local design work
DEMO_MODE=false
# Optional. Defaults to Render's commit SHA (RENDER_GIT_COMMIT)
DEPLOYMENT_ID=

# ── 3. Secrets you generate yourself ───────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# INTERNAL_API_TOKEN must also be added as a GitHub Actions secret, together with SITE_URL
GITHUB_WEBHOOK_SECRET=
INTERNAL_API_TOKEN=

# ── 4. GitHub App ──────────────────────────────────────────────────────────
# https://github.com/settings/apps/new  (App ID is on the App's General page)
GITHUB_APP_ID=
# General page → "Generate a private key" → paste the whole .pem.
# In .env.local put it on one line in double quotes with \n for line breaks.
GITHUB_APP_PRIVATE_KEY=
# https://github.com/apps/<your-app-slug>
NEXT_PUBLIC_GITHUB_APP_URL=
# Leave false until a dry run looks right, then true to allow opening PRs
GITHUB_WRITES_ENABLED=false
SCHEDULER_ENABLED=true
GITHUB_MIN_INTERVAL_MS=250

# ── 5. Optional: higher API rate limits ────────────────────────────────────
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# https://github.com/settings/personal-access-tokens/new  (public repos, no permissions)
GITHUB_TOKEN=

# ── 6. Optional: treasury and token ────────────────────────────────────────
# PUBLIC wallet address only. Never a private key or seed phrase.
TREASURY_WALLET=
# Public RPC is rate limited; a free key from https://www.helius.dev works better
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional build-time fallback. Prefer `npm run ca -- <address>`: it updates the live site instantly, no redeploy.
NEXT_PUBLIC_CONTRACT_ADDRESS=
